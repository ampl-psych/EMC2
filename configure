#!/bin/sh
# configure — build-time options for EMC2
# Hand-written; do not replace with autoconf output.
#
# Usage:
#   R CMD INSTALL .
#   R CMD INSTALL --configure-args="[OPTIONS]" .
#
# In R:
#   devtools::install(args = c("--configure-args='[OPTIONS]'"))
#
# Run ./configure --help for available options.

# --------------------------------------------------------------------------- #
#  Defaults                                                                    #
# --------------------------------------------------------------------------- #
PNORM_MODE=1        # 1 = Hart (near-double precision, thread-safe)
FAST_MATH=no        # fast-math disabled by default
ENABLE_NATIVE=no    # native optimizations disabled by default
ENABLE_OPENMP=yes

# --------------------------------------------------------------------------- #
#  Argument parsing                                                            #
# --------------------------------------------------------------------------- #
for arg in "$@"; do
  case "$arg" in
    --help|-h)
      cat <<EOF

configure options for EMC2:

  --with-pnorm-mode=N     Select pnorm implementation (default: 1):
                            0  R::pnorm        exact, not thread-safe and slow
                            1  Hart (1968)     near-double precision (~1.2e-15),
                                               thread-safe  [default]
                            2  A&S 7.1.26      single-precision quality (~1.5e-7),
                                               thread-safe, best vectorisability

  --enable-fast-math      Add -ffast-math -fno-math-errno (default: disabled).
                          Improves speed but may affect floating-point semantics.
                          Recommended only with --with-pnorm-mode=1 or =2.

  --native                Add -march=native (default: disabled).
                          Improves speed via architecture-specific optimizations.
                          Disabled by default for CRAN compatibility.

  --disable-openmp        Build the serial sampler without OpenMP.

  --help, -h              Show this help message and exit.

Examples:
  R CMD INSTALL .
  R CMD INSTALL --configure-args="--with-pnorm-mode=1 --enable-fast-math --native" .

EOF
      exit 0
      ;;
    --with-pnorm-mode=*)
      PNORM_MODE="${arg#*=}"
      case "$PNORM_MODE" in
        0|1|2) ;;
        *)
          echo "configure: error: --with-pnorm-mode must be 0, 1, or 2 (got '$PNORM_MODE')" >&2
          exit 1
          ;;
      esac
      ;;
    --enable-fast-math)
      FAST_MATH=yes
      ;;
    --disable-fast-math)
      FAST_MATH=no
      ;;
    --native)
      ENABLE_NATIVE=yes
      ;;
    --disable-openmp)
      ENABLE_OPENMP=no
      ;;
    *)
      echo "configure: warning: unrecognised option '$arg' (ignored)" >&2
      ;;
  esac
done

# --------------------------------------------------------------------------- #
#  R's compiler — split binary from embedded flags (e.g. "g++ -std=gnu++17") #
# --------------------------------------------------------------------------- #
R_BIN="${R_HOME:+${R_HOME}/bin/}R"
CXX_FULL="$("$R_BIN" CMD config CXX17)"
CXX_BIN="$(echo "$CXX_FULL"  | awk '{print $1}')"
CXX_STD="$(echo "$CXX_FULL" | cut -s -d' ' -f2-) $("$R_BIN" CMD config CXX17STD)"
R_CXXFLAGS="$("$R_BIN" CMD config CXX17FLAGS)"
R_CPPFLAGS="$("$R_BIN" CMD config CPPFLAGS)"
R_LDFLAGS="$("$R_BIN" CMD config LDFLAGS)"

# --------------------------------------------------------------------------- #
#  Extra user-requested flags                                                  #
# --------------------------------------------------------------------------- #
EXTRA_CXXFLAGS=""
if [ "$FAST_MATH" = "yes" ]; then
  EXTRA_CXXFLAGS="$EXTRA_CXXFLAGS -ffast-math -fno-math-errno"
fi
if [ "$ENABLE_NATIVE" = "yes" ]; then
  # Only add -march=native if R's own CXXFLAGS don't already contain it
  case "$R_CXXFLAGS" in
    *-march=native*) ;;
    *) EXTRA_CXXFLAGS="$EXTRA_CXXFLAGS -march=native" ;;
  esac
fi

# --------------------------------------------------------------------------- #
#  Platform detection — Accelerate framework (macOS only)                     #
# --------------------------------------------------------------------------- #
ACCELERATE_LIBS=""
LINALG_LIBS='$(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)'
case "$(uname)" in
  Darwin) ACCELERATE_LIBS="-framework Accelerate" ;;
esac

# --------------------------------------------------------------------------- #
#  OpenMP detection — compile test using R's own compiler                     #
# --------------------------------------------------------------------------- #
OMP_CXXFLAGS=""
OMP_LIBS=""

OMP_TMP="$(mktemp -d "${TMPDIR:-/tmp}/emc2-openmp.XXXXXX")" || exit 1
trap 'rm -rf "$OMP_TMP"' EXIT HUP INT TERM

# macOS R libraries may already link their own Fortran runtime.
if [ "$(uname)" = Darwin ]; then
  cat > "$OMP_TMP/linalg.cpp" <<'EOF'
extern "C" void dpotrf_();
extern "C" void dgemm_();
int main() { dpotrf_(); dgemm_(); }
EOF
  if $CXX_BIN $CXX_STD $R_CXXFLAGS $R_CPPFLAGS "$OMP_TMP/linalg.cpp" \
        $("$R_BIN" CMD config LAPACK_LIBS) $("$R_BIN" CMD config BLAS_LIBS) \
        $R_LDFLAGS -o "$OMP_TMP/linalg" 2>/dev/null; then
    LINALG_LIBS='$(LAPACK_LIBS) $(BLAS_LIBS)'
  fi
fi

cat > "$OMP_TMP/test.cpp" <<'OMPEOF'
#include <omp.h>
#if !defined(_OPENMP) || _OPENMP < 201307
#error OpenMP 4.0 is required for task groups
#endif
int main() { return omp_get_max_threads() < 1; }
OMPEOF

if [ "$ENABLE_OPENMP" = yes ]; then
case "$(uname)" in
  Darwin)
    # Prefer the runtime shipped with CRAN R; fall back to Homebrew.
    R_LIB="$("$R_BIN" RHOME)/lib"
    for prefix in /usr/local /opt/homebrew/opt/libomp /usr/local/opt/libomp; do
      if $CXX_BIN $CXX_STD $R_CXXFLAGS $R_CPPFLAGS \
            -Xclang -fopenmp \
            -I"${prefix}/include" \
            "$OMP_TMP/test.cpp" -o "$OMP_TMP/test" \
            -L"$R_LIB" $R_LDFLAGS -L"${prefix}/lib" -lomp 2>/dev/null; then
        OMP_CXXFLAGS="-Xclang -fopenmp -I${prefix}/include"
        OMP_LIBS="-L\"$R_LIB\" -L${prefix}/lib -lomp"
        echo "configure: OpenMP enabled"
        break
      fi
    done
    ;;
  *)
    if $CXX_BIN $CXX_STD $R_CXXFLAGS $R_CPPFLAGS \
          -fopenmp \
          "$OMP_TMP/test.cpp" -o "$OMP_TMP/test" $R_LDFLAGS 2>/dev/null; then
      OMP_CXXFLAGS="-fopenmp"
      OMP_LIBS="-fopenmp"
      echo "configure: OpenMP enabled via -fopenmp"
    fi
    ;;
esac
fi

if [ -z "$OMP_LIBS" ]; then
  echo "configure: OpenMP not available, building without it (single-threaded fallback)"
fi

# Probe the pool-release API; GCC 9 provides it but reports OpenMP 4.5.
OMP_PAUSE=0
if [ -n "$OMP_LIBS" ]; then
  cat > "$OMP_TMP/pause.cpp" <<'OMPEOF'
#include <omp.h>
int main() { return omp_pause_resource_all(omp_pause_hard); }
OMPEOF
  case "$(uname)" in
    Darwin)
      if $CXX_BIN $CXX_STD $R_CXXFLAGS $R_CPPFLAGS $OMP_CXXFLAGS \
            "$OMP_TMP/pause.cpp" -L"$R_LIB" $R_LDFLAGS -L"${prefix}/lib" -lomp \
            -o "$OMP_TMP/pause" 2>/dev/null; then OMP_PAUSE=1; fi
      ;;
    *)
      if $CXX_BIN $CXX_STD $R_CXXFLAGS $R_CPPFLAGS $OMP_CXXFLAGS \
            "$OMP_TMP/pause.cpp" $R_LDFLAGS $OMP_LIBS \
            -o "$OMP_TMP/pause" 2>/dev/null; then OMP_PAUSE=1; fi
      ;;
  esac
fi

# --------------------------------------------------------------------------- #
#  Summary                                                                     #
# --------------------------------------------------------------------------- #
echo "configure: EMC2 build configuration"
echo "  PNORM_MODE    : $PNORM_MODE"
echo "  fast-math     : $FAST_MATH"
echo "  native        : $ENABLE_NATIVE"
echo "  Accelerate    : ${ACCELERATE_LIBS:-no}"
echo "  OpenMP CXX    : ${OMP_CXXFLAGS:-disabled}"
echo "  OpenMP libs   : ${OMP_LIBS:-disabled}"
echo "  OpenMP pause  : $OMP_PAUSE"
echo "  Compiler      : $CXX_BIN $CXX_STD"
echo "  R CXXFLAGS    : $R_CXXFLAGS"

# --------------------------------------------------------------------------- #
#  Write src/Makevars from src/Makevars.in                                    #
# --------------------------------------------------------------------------- #
sed \
  -e "s|@PNORM_MODE@|${PNORM_MODE}|g" \
  -e "s|@OMP_CXXFLAGS@|${OMP_CXXFLAGS}|g" \
  -e "s|@OMP_LIBS@|${OMP_LIBS}|g" \
  -e "s|@EXTRA_CXXFLAGS@|${EXTRA_CXXFLAGS}|g" \
  -e "s|@ACCELERATE_LIBS@|${ACCELERATE_LIBS}|g" \
  -e "s|@LINALG_LIBS@|${LINALG_LIBS}|g" \
  src/Makevars.in > src/Makevars

echo "configure: src/Makevars written"

# --------------------------------------------------------------------------- #
#  Write inst/include/build_info.h from inst/include/build_info.h.in          #
# --------------------------------------------------------------------------- #
OMP_LIBS_HEADER=$(printf '%s\n' "$OMP_LIBS" | sed 's/"/\\\\"/g')
sed \
  -e "s|@PNORM_MODE@|${PNORM_MODE}|g" \
  -e "s|@FAST_MATH@|${FAST_MATH}|g" \
  -e "s|@ENABLE_NATIVE@|${ENABLE_NATIVE}|g" \
  -e "s|@OMP_CXXFLAGS@|${OMP_CXXFLAGS}|g" \
  -e "s|@OMP_LIBS@|${OMP_LIBS_HEADER}|g" \
  -e "s|@OMP_PAUSE@|${OMP_PAUSE}|g" \
  -e "s|@EXTRA_CXXFLAGS@|${EXTRA_CXXFLAGS}|g" \
  -e "s|@ACCELERATE_LIBS@|${ACCELERATE_LIBS}|g" \
  inst/include/build_info.h.in > inst/include/build_info.h

echo "configure: inst/include/build_info.h written"
