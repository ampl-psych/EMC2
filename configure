#!/bin/sh
# configure — build-time options for EMC2
# Hand-written; do not replace with autoconf output.
#
# Usage:
#   R CMD INSTALL .
#   R CMD INSTALL --configure-args="[OPTIONS]" .
#
# In R:
#   devtools::install(args = c("--configure-args='[OPTIONS]'"))
#
# Run ./configure --help for available options.

# --------------------------------------------------------------------------- #
#  Defaults                                                                    #
# --------------------------------------------------------------------------- #
PNORM_MODE=1        # 1 = Hart (near-double precision, thread-safe)
FAST_MATH=no        # fast-math disabled by default
ENABLE_NATIVE=no    # native optimizations disabled by default

# --------------------------------------------------------------------------- #
#  Argument parsing                                                            #
# --------------------------------------------------------------------------- #
for arg in "$@"; do
  case "$arg" in
    --help|-h)
      cat <<EOF

configure options for EMC2:

  --with-pnorm-mode=N     Select pnorm implementation (default: 1):
                            0  R::pnorm        exact, not thread-safe and slow
                            1  Hart (1968)     near-double precision (~1.2e-15),
                                               thread-safe  [default]
                            2  A&S 7.1.26      single-precision quality (~1.5e-7),
                                               thread-safe, best vectorisability

  --enable-fast-math      Add -ffast-math -fno-math-errno (default: disabled).
                          Improves speed but may affect floating-point semantics.
                          Recommended only with --with-pnorm-mode=1 or =2.

  --native                Add -march=native (default: disabled).
                          Improves speed via architecture-specific optimizations.
                          Disabled by default for CRAN compatibility.

  --help, -h              Show this help message and exit.

Examples:
  R CMD INSTALL .
  R CMD INSTALL --configure-args="--with-pnorm-mode=1 --enable-fast-math --native" .

EOF
      exit 0
      ;;
    --with-pnorm-mode=*)
      PNORM_MODE="${arg#*=}"
      case "$PNORM_MODE" in
        0|1|2) ;;
        *)
          echo "configure: error: --with-pnorm-mode must be 0, 1, or 2 (got '$PNORM_MODE')" >&2
          exit 1
          ;;
      esac
      ;;
    --enable-fast-math)
      FAST_MATH=yes
      ;;
    --disable-fast-math)
      FAST_MATH=no
      ;;
    --native)
      ENABLE_NATIVE=yes
      ;;
    *)
      echo "configure: warning: unrecognised option '$arg' (ignored)" >&2
      ;;
  esac
done

# --------------------------------------------------------------------------- #
#  R's compiler — split binary from embedded flags (e.g. "g++ -std=gnu++17") #
# --------------------------------------------------------------------------- #
CXX_FULL="$(R CMD config CXX)"
CXX_BIN="$(echo "$CXX_FULL"  | awk '{print $1}')"
CXX_STD="$(echo "$CXX_FULL"  | cut -s -d' ' -f2-)"
R_CXXFLAGS="$(R CMD config CXXFLAGS)"

# --------------------------------------------------------------------------- #
#  Extra user-requested flags                                                  #
# --------------------------------------------------------------------------- #
EXTRA_CXXFLAGS=""
if [ "$FAST_MATH" = "yes" ]; then
  EXTRA_CXXFLAGS="$EXTRA_CXXFLAGS -ffast-math -fno-math-errno"
fi
if [ "$ENABLE_NATIVE" = "yes" ]; then
  # Only add -march=native if R's own CXXFLAGS don't already contain it
  case "$R_CXXFLAGS" in
    *-march=native*) ;;
    *) EXTRA_CXXFLAGS="$EXTRA_CXXFLAGS -march=native" ;;
  esac
fi

# --------------------------------------------------------------------------- #
#  Platform detection — Accelerate framework (macOS only)                     #
# --------------------------------------------------------------------------- #
ACCELERATE_LIBS=""
case "$(uname)" in
  Darwin) ACCELERATE_LIBS="-framework Accelerate" ;;
esac

# --------------------------------------------------------------------------- #
#  OpenMP detection — compile test using R's own compiler                     #
# --------------------------------------------------------------------------- #
OMP_CXXFLAGS=""
OMP_LIBS=""

cat > /tmp/omp_test.cpp <<'OMPEOF'
#include <omp.h>
int main() { return omp_get_max_threads(); }
OMPEOF

case "$(uname)" in
  Darwin)
    for prefix in /opt/homebrew /usr/local; do
      if $CXX_BIN $CXX_STD $R_CXXFLAGS \
            -Xclang -fopenmp \
            -I"${prefix}/opt/libomp/include" \
            -L"${prefix}/opt/libomp/lib" -lomp \
            /tmp/omp_test.cpp -o /tmp/omp_test 2>/dev/null; then
        OMP_CXXFLAGS="-Xclang -fopenmp -I${prefix}/opt/libomp/include"
        OMP_LIBS="-L${prefix}/opt/libomp/lib -lomp"
        echo "configure: OpenMP enabled via ${prefix}/opt/libomp"
        break
      fi
    done
    ;;
  *)
    if $CXX_BIN $CXX_STD $R_CXXFLAGS \
          -fopenmp \
          /tmp/omp_test.cpp -o /tmp/omp_test 2>/dev/null; then
      OMP_CXXFLAGS="-fopenmp"
      OMP_LIBS="-fopenmp"
      echo "configure: OpenMP enabled via -fopenmp"
    fi
    ;;
esac

rm -f /tmp/omp_test.cpp /tmp/omp_test

if [ -z "$OMP_LIBS" ]; then
  echo "configure: OpenMP not available, building without it (single-threaded fallback)"
fi

# --------------------------------------------------------------------------- #
#  Summary                                                                     #
# --------------------------------------------------------------------------- #
echo "configure: EMC2 build configuration"
echo "  PNORM_MODE    : $PNORM_MODE"
echo "  fast-math     : $FAST_MATH"
echo "  native        : $ENABLE_NATIVE"
echo "  Accelerate    : ${ACCELERATE_LIBS:-no}"
echo "  OpenMP CXX    : ${OMP_CXXFLAGS:-disabled}"
echo "  OpenMP libs   : ${OMP_LIBS:-disabled}"
echo "  Compiler      : $CXX_BIN $CXX_STD"
echo "  R CXXFLAGS    : $R_CXXFLAGS"

# --------------------------------------------------------------------------- #
#  Write src/Makevars from src/Makevars.in                                    #
# --------------------------------------------------------------------------- #
sed \
  -e "s|@PNORM_MODE@|${PNORM_MODE}|g" \
  -e "s|@OMP_CXXFLAGS@|${OMP_CXXFLAGS}|g" \
  -e "s|@OMP_LIBS@|${OMP_LIBS}|g" \
  -e "s|@EXTRA_CXXFLAGS@|${EXTRA_CXXFLAGS}|g" \
  -e "s|@ACCELERATE_LIBS@|${ACCELERATE_LIBS}|g" \
  src/Makevars.in > src/Makevars

echo "configure: src/Makevars written"

# --------------------------------------------------------------------------- #
#  Write inst/include/build_info.h from inst/include/build_info.h.in          #
# --------------------------------------------------------------------------- #
sed \
  -e "s|@PNORM_MODE@|${PNORM_MODE}|g" \
  -e "s|@FAST_MATH@|${FAST_MATH}|g" \
  -e "s|@ENABLE_NATIVE@|${ENABLE_NATIVE}|g" \
  -e "s|@OMP_CXXFLAGS@|${OMP_CXXFLAGS}|g" \
  -e "s|@OMP_LIBS@|${OMP_LIBS}|g" \
  -e "s|@EXTRA_CXXFLAGS@|${EXTRA_CXXFLAGS}|g" \
  -e "s|@ACCELERATE_LIBS@|${ACCELERATE_LIBS}|g" \
  inst/include/build_info.h.in > inst/include/build_info.h

echo "configure: inst/include/build_info.h written"
