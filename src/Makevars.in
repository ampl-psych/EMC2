# src/Makevars.in — processed by ./configure into src/Makevars
# Do not edit src/Makevars directly; edit this file instead.

# The C++ sources use C++17 (structured bindings, if constexpr); declare it so
# toolchains whose default is older (e.g. Intel icpc on NCI Gadi) compile.
CXX_STD = CXX17

# The sampler owns threading; Armadillo must not print from worker threads.
# No Fortran is compiled here, so $(FLIBS) is not linked: on macOS it names a
# gfortran runtime that is absent unless gfortran is installed.
PKG_CPPFLAGS = -I../inst/include -DPNORM_MODE=@PNORM_MODE@ -DARMA_WARN_LEVEL=0 -DARMA_DONT_USE_OPENMP
PKG_LIBS     = @OMP_LIBS@ $(LAPACK_LIBS) $(BLAS_LIBS) @ACCELERATE_LIBS@
PKG_CXXFLAGS = @OMP_CXXFLAGS@ @EXTRA_CXXFLAGS@

SAMPLER_OBJECTS = sampler/group.o sampler/infnt_factor.o sampler/likelihood.o \
  sampler/particle.o sampler/proposals.o sampler/runner.o sampler/sem.o
OBJECTS = CensorSpec.o ParamTable.o RcppExports.o TrendEngine.o TruncSpec.o \
  build_info.o custom_trend_interface.o fa.o group_designs.o hcubature.o kernels.o \
  math_utils_apple.o math_utils_generic.o model_DDM.o model_LBA.o model_RDM.o \
  model_exgaussian.o model_lnr.o model_multinomial.o mri.o param_table_interface.o \
  particle_ll.o rCDM.o sampler.o transform_utils.o utility_functions.o $(SAMPLER_OBJECTS)

all: $(SHLIB)

# Every object depends on every header: an in-place rebuild after a header
# change must recompile all of them, or the link mixes stale and new objects
# (seen as a segfault in ParamTable after RaceSetup.h changed).
HEADERS = $(wildcard *.h) $(wildcard sampler/*.h) $(wildcard ../inst/include/*.h) \
  $(wildcard ../inst/include/EMC2/*.h)
$(OBJECTS): $(HEADERS)

.PHONY: all clean

clean:
	rm -f $(OBJECTS) $(SHLIB)
